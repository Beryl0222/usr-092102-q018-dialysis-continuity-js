{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "高原透析连续调度领域事件",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "aggregate_type",
    "aggregate_id",
    "occurred_at",
    "version",
    "summary"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1,
      "description": "事件标识，即幂等键：同一 event_id 重复投递必须按已处理对待，不得重复改变系统状态；接收方返回首次处理结果。"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "PLAN_CONFIRMED",
        "CAPACITY_CHANGED",
        "SESSION_RESERVED",
        "SESSION_LOCKED",
        "SESSION_CLOSED",
        "TRANSFER_PROPOSED",
        "TRANSFER_ACCEPTED",
        "TREATMENT_RECONCILED",
        "ROUTE_STATUS_CHANGED",
        "SETTLEMENT_RECORDED"
      ]
    },
    "aggregate_type": {
      "type": "string",
      "enum": [
        "treatment_plan",
        "resource_capacity",
        "dialysis_session",
        "transfer_handoff",
        "route_status",
        "settlement"
      ]
    },
    "aggregate_id": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time",
      "description": "业务发生时间，须携带发生地时区偏移。离线补录一律以该时间对账，而不是以入库时间对账。"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "同一聚合内从 1 开始严格递增，用于乐观并发与顺序重放。"
    },
    "summary": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true
}
